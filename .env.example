# ---------------------------------------------------------------------------
# Document Automation - environment configuration
# Copy this file to .env and adjust the values. Never commit the real .env.
# Relative paths are resolved against the project folder.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Storage (documents, page images, OCR results, temporary files) and logs
STORAGE_DIR=storage
LOG_DIR=logs

# Uploads have no file size or page count limit.
# Memory safeguard (not a file size limit): largest single page image in pixels
# (width x height) that will be rendered. Raise it if the server has more memory.
MAX_PAGE_PIXELS=60000000

# PDF DPI is fixed by the requirements: minimum 50, maximum 300, default 75.
# It is selected per upload on the Upload page and is not configured here.

# How an unclear date such as 03/04/2025 is read: dmy = day/month/year, mdy = month/day/year.
INVOICE_DATE_ORDER=dmy

# OCR - PaddleOCR 3.x
# onnxruntime : works on Windows 11 and Oracle Linux 7.9 (default)
# paddle      : Windows 11 only, needs requirements-paddle-windows.txt
OCR_ENGINE=onnxruntime
OCR_DEVICE=cpu
# Small models: about 3 s per A4 page on a 4-thread laptop CPU.
# Medium models (PP-OCRv6_medium_det / PP-OCRv6_medium_rec) are slower.
OCR_TEXT_DETECTION_MODEL=PP-OCRv6_small_det
OCR_TEXT_RECOGNITION_MODEL=PP-OCRv6_small_rec
OCR_MODEL_DIR=models
OCR_CPU_THREADS=4
# Paddle engine only. Keep false for PaddlePaddle 3.3.x on CPU.
OCR_ENABLE_MKLDNN=false
# Detail pass: a PDF page whose content could not be read completely (small print at a low DPI)
# is rendered again at this DPI and read again. Only those pages; 0 turns it off.
OCR_DETAIL_DPI=150

# Oracle Database 19c (optional - document processing works without it)
ORACLE_ENABLED=false
ORACLE_USER=
ORACLE_PASSWORD=
# Easy Connect string, for example: dbhost.example.com:1521/ORCLPDB1
ORACLE_DSN=
# Empty = Thin mode (no Oracle Client). Set a folder to use Thick mode:
#   Windows example: C:\Oracle\instantclient_19
#   Linux example:   /usr/lib/oracle/19.28/client64/lib
ORACLE_CLIENT_LIB_DIR=
# Thick mode: folder with this app's sqlnet.ora (avoids NTS authentication errors ORA-12637 / ORA-28547)
ORACLE_CONFIG_DIR=deploy/oracle-client
ORACLE_CONNECT_TIMEOUT=10
# Owner of the staging tables, when they are in another schema than ORACLE_USER (empty = same schema)
ORACLE_SCHEMA=
# Name stored as the reviewer / poster of data sent to the database
APP_USER_NAME=document-automation
